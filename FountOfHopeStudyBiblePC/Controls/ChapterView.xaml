<!-- Controls/ChapterView.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.ChapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="ChapterRoot">
    <Grid>

        <!-- ══ Background layer ══════════════════════════════════════ -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Visibility="Collapsed"/>

        <Border x:Name="OverlayBorder"
                Visibility="Collapsed"/>

        <!-- ══ Content layer ═════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Inline header (multi-version only) ──────────────── -->
            <Border x:Name="InlineHeader"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Height="28"
                    CornerRadius="4"
                    Margin="2"
                    Background="{DynamicResource AccentBrush}">
                <Grid Margin="6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="InlineBookChapterBtn"
                                Padding="6,2"
                                Background="#33000000"
                                BorderThickness="0"
                                Click="InlineBookChapterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InlineBookText"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"/>
                                <TextBlock x:Name="InlineChapterText"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="InlineVersionBtn"
                                Padding="6,2"
                                Margin="4,0,0,0"
                                Background="#33000000"
                                BorderThickness="0"
                                Click="InlineVersionBtn_Click">
                            <TextBlock x:Name="InlineVersionText"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                        </Button>

                        <!-- Chapter cycle: prev / next within current book -->
                        <Button x:Name="InlinePrevChapterBtn"
                                Width="22" Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="InlinePrevChapterBtn_Click"
                                ToolTip="Previous chapter">
                            <iconPacks:PackIconMaterial x:Name="InlinePrevChapterIcon"
                                                        Kind="ChevronLeft"
                                                        Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="InlineNextChapterBtn"
                                Width="22" Height="22"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="InlineNextChapterBtn_Click"
                                ToolTip="Next chapter">
                            <iconPacks:PackIconMaterial x:Name="InlineNextChapterIcon"
                                                        Kind="ChevronRight"
                                                        Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Nav row — only in landscape-vertical-multi -->
                        <StackPanel x:Name="InlineNavPanel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button x:Name="InlineHomeBtn" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Click="InlineHomeBtn_Click">
                                <iconPacks:PackIconMaterial x:Name="InlineHomeIcon"
                                                            Kind="Home"
                                                            Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="InlineBookmarksBtn" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Click="InlineBookmarksBtn_Click">
                                <iconPacks:PackIconMaterial x:Name="InlineBookmarksIcon"
                                                            Kind="BookmarkMultiple"
                                                            Width="13" Height="13"/>
                            </Button>
                            <Button x:Name="InlineNotesBtn" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Click="InlineNotesBtn_Click">
                                <iconPacks:PackIconMaterial x:Name="InlineNotesIcon"
                                                            Kind="NoteText"
                                                            Width="13" Height="13"
                                                            RenderTransformOrigin="0.5,0.5">
                                    <iconPacks:PackIconMaterial.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </iconPacks:PackIconMaterial.RenderTransform>
                                </iconPacks:PackIconMaterial>
                            </Button>
                            <Button x:Name="InlineSearchBtn" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Click="InlineSearchBtn_Click">
                                <iconPacks:PackIconMaterial x:Name="InlineSearchIcon"
                                                            Kind="Magnify"
                                                            Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="InlineSettingsBtn" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Click="InlineSettingsBtn_Click">
                                <iconPacks:PackIconMaterial x:Name="InlineSettingsIcon"
                                                            Kind="Cog"
                                                            Width="14" Height="14"/>
                            </Button>
                        </StackPanel>

                        <!-- Theme -->
                        <Button x:Name="InlineThemeBtn" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0"
                                Click="InlineThemeBtn_Click">
                            <iconPacks:PackIconMaterial x:Name="InlineThemeIcon"
                                                        Kind="Brightness2"
                                                        Width="14" Height="14"
                                                        RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </iconPacks:PackIconMaterial.RenderTransform>
                            </iconPacks:PackIconMaterial>
                        </Button>

                        <!-- Color -->
                        <Button x:Name="InlineColorBtn" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0"
                                Click="InlineColorBtn_Click">
                            <iconPacks:PackIconMaterial x:Name="InlineColorIcon"
                                                        Kind="Palette"
                                                        Width="14" Height="14"/>
                        </Button>

                        <!-- Scroll sync — multi only -->
                        <Button x:Name="InlineScrollSyncBtn" Width="22" Height="22"
                                Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0"
                                Click="InlineScrollSyncBtn_Click">
                            <iconPacks:PackIconMaterial x:Name="InlineScrollSyncIcon"
                                                        Kind="LinkVariant"
                                                        Width="14" Height="14"/>
                        </Button>

                        <!-- Layout (popup) -->
                        <Button x:Name="InlineLayoutBtn" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0"
                                Click="InlineLayoutBtn_Click">
                            <iconPacks:PackIconMaterial x:Name="InlineLayoutIcon"
                                                        Kind="ViewGrid"
                                                        Width="14" Height="14"/>
                        </Button>

                        <!-- Menu (popup) -->
                        <Button x:Name="InlineMenuBtn" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0"
                                Click="InlineMenuBtn_Click">
                            <iconPacks:PackIconMaterial x:Name="InlineMenuIcon"
                                                        Kind="Menu"
                                                        Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Scrollable verse list ──────────────────────────── -->
            <ScrollViewer x:Name="VerseScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="4,0,4,0">
                <ItemsControl x:Name="VerseItems"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>