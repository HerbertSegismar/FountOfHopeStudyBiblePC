<!-- Controls/ChapterView.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.ChapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ChapterRoot">
    <Grid>

        <!-- ══ Background layer ══════════════════════════════════════ -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Visibility="Collapsed"/>

        <Border x:Name="OverlayBorder"
                Visibility="Collapsed"/>

        <!-- ══ Content layer ═════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Inline header (multi-version mode) ─────────────── -->
            <Border x:Name="InlineHeader"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Height="28"
                    CornerRadius="4"
                    Margin="2"
                    Background="{DynamicResource AccentBrush}">
                <Grid Margin="6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="InlineBookChapterBtn"
                                Padding="6,2"
                                Background="#33000000"
                                BorderThickness="0"
                                Click="InlineBookChapterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InlineBookText"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"/>
                                <TextBlock x:Name="InlineChapterText"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="4,0,0,0"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="InlineVersionBtn"
                                Padding="6,2"
                                Margin="4,0,0,0"
                                Background="#33000000"
                                BorderThickness="0"
                                Click="InlineVersionBtn_Click">
                            <TextBlock x:Name="InlineVersionText"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="InlineThemeBtn"
                                Width="22" Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="InlineThemeBtn_Click">
                            <TextBlock x:Name="InlineThemeIcon"
                                       Text="☾"
                                       FontSize="14"
                                       Foreground="White"/>
                        </Button>

                        <Button x:Name="InlineColorBtn"
                                Width="22" Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="InlineColorBtn_Click">
                            <TextBlock Text="🎨" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Scrollable verse list ──────────────────────────── -->
            <ScrollViewer x:Name="VerseScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="4,0,4,0">
                <ItemsControl x:Name="VerseItems"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>