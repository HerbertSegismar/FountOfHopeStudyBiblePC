<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.ImageSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border x:Name="RootCard" Margin="16,0" CornerRadius="18" ClipToBounds="True"
            Height="400"
            Background="{DynamicResource CardBackground}"
            MouseLeftButtonUp="OnCardClick"
            Cursor="Hand">
		<Grid>
			<Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.75"/>
			<Border Background="#55000000"/>

			<!-- Verse overlay -->
			<Border x:Name="OverlayPanel" VerticalAlignment="Bottom">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
						<GradientStop Color="#CC000000" Offset="0"/>
						<GradientStop Color="#66000000" Offset="0.4"/>
						<GradientStop Color="#00000000" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
				<StackPanel Margin="20,12" HorizontalAlignment="Center">
					<TextBlock Text="Daily Inspiration" FontSize="13"
                               FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
					<TextBlock x:Name="OverlayVerse" FontSize="17" FontStyle="Italic"
                               Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
					<TextBlock x:Name="OverlayRef" FontSize="12" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
				</StackPanel>
			</Border>

			<!-- Effects layer (snow/orbs/meteors) -->
			<Canvas x:Name="EffectsLayer" IsHitTestVisible="False"/>

			<!-- Share / download -->
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="10">
				<Button x:Name="ShareButton" Click="OnShareClick" Width="28" Height="28"
                        Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                        ToolTip="Share">
					<Path Fill="White" Stretch="Uniform" Width="16" Height="16"
                          Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"/>
				</Button>
				<Button x:Name="DownloadButton" Click="OnDownloadClick" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" ToolTip="Download">
					<Path Fill="White" Stretch="Uniform" Width="16" Height="16"
                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
				</Button>
			</StackPanel>

			<!-- Loading placeholder -->
			<Border x:Name="LoadingPlaceholder" Background="{DynamicResource CardBackground}">
				<TextBlock Text="Loading image..." Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>

			<!-- Fallback (no image) -->
			<Border x:Name="FallbackPanel" Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<TextBlock x:Name="FallbackHeader" Text="Daily Inspiration"
                               FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
					<TextBlock x:Name="FallbackVerse" FontSize="17" FontStyle="Italic"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
					<TextBlock x:Name="FallbackRef" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>