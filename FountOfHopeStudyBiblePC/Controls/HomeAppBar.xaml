<!-- Controls/HomeAppBar.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.HomeAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="AppBarRoot">
    <Grid Height="64">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource AppPrimaryColor}" Offset="0.6"/>
                <GradientStop Color="{DynamicResource AppPrimaryColor}" Offset="0.85"/>
                <GradientStop Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Back button — 35px to match ReaderAppBar (IconButtonSize). -->
        <Button x:Name="BackButton"
                Grid.Column="0"
                Width="35" Height="35"
                Margin="6,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BackButton_Click">
            <iconPacks:PackIconMaterial x:Name="BackIcon"
                                        Kind="ArrowLeft"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
        </Button>

        <TextBlock x:Name="TitleText"
                   Grid.Column="1"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

        <StackPanel x:Name="ActionsPanel"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
    </Grid>
</UserControl>