<!-- Controls/HomeAppBar.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.HomeAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="AppBarRoot">
    <Grid Height="64">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CC7FB2FF" Offset="0.6"/>
                <GradientStop Color="#CC7FB2FF" Offset="0.85"/>
                <GradientStop Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- back -->
            <ColumnDefinition Width="Auto"/>
            <!-- title -->
            <ColumnDefinition Width="*"/>
            <!-- spacer -->
            <ColumnDefinition Width="Auto"/>
            <!-- actions -->
        </Grid.ColumnDefinitions>

        <!-- Back button (hidden unless there's a back stack) -->
        <Button x:Name="BackButton"
                Grid.Column="0"
                Width="36" Height="36"
                Margin="6,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BackButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="18" Background="Transparent">
                        <TextBlock Text="←" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Title -->
        <TextBlock x:Name="TitleText"
                   Grid.Column="1"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

        <!-- Dynamic actions (icon buttons + hamburger) -->
        <StackPanel x:Name="ActionsPanel"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
    </Grid>
</UserControl>