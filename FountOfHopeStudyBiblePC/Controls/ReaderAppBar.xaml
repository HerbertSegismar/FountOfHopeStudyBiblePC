<!-- Controls/ReaderAppBar.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.ReaderAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="AppBarRoot">
    <Grid Height="64">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CC7FB2FF" Offset="0.6"/>
                <GradientStop Color="#CC7FB2FF" Offset="0.85"/>
                <GradientStop Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- back -->
            <ColumnDefinition Width="Auto"/>
            <!-- book/chapter -->
            <ColumnDefinition Width="Auto"/>
            <!-- version -->
            <ColumnDefinition Width="*"/>
            <!-- spacer -->
            <ColumnDefinition Width="Auto"/>
            <!-- actions -->
        </Grid.ColumnDefinitions>

        <!-- Back -->
        <Button x:Name="BackButton"
                Grid.Column="0"
                Width="36" Height="36"
                Margin="6,0,4,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="BackButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="18" Background="Transparent">
                        <TextBlock Text="←" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Book / chapter -->
        <Button x:Name="BookChapterButton"
                Grid.Column="1"
                Padding="8,2"
                Margin="0,0,4,0"
                Background="#33000000"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Navigate to passage"
                Click="BookChapterButton_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BookText"
                           FontWeight="Bold" FontSize="15" Foreground="White"
                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChapterText"
                           FontWeight="Bold" FontSize="15" Foreground="White"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Version -->
        <Button x:Name="VersionButton"
                Grid.Column="2"
                Padding="8,2"
                Background="#33000000"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Change version"
                Click="VersionButton_Click">
            <TextBlock x:Name="VersionText"
                       FontWeight="Bold" FontSize="15" Foreground="White"/>
        </Button>

        <!-- Actions -->
        <StackPanel x:Name="ActionsPanel"
                    Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
    </Grid>
</UserControl>