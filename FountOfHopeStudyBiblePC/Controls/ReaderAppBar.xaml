<UserControl x:Class="FountOfHopeStudyBiblePC.Controls.ReaderAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Button x:Name="BackButton" Click="BackButton_Click"
                Width="30" Height="30" HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="6,0,0,0"
                Background="Transparent" BorderThickness="0"
                Cursor="Hand" ToolTip="Back">
            <iconPacks:PackIconMaterial x:Name="BackIcon"
                                        Kind="ArrowLeft"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
        </Button>

        <Grid x:Name="TitleRow" Margin="40,0,300,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBookCol"    Width="Auto" MaxWidth="240"/>
                <ColumnDefinition x:Name="TitleVersionCol" Width="Auto" MaxWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BookChapterButton" Grid.Column="0"
                    Click="BookChapterButton_Click" Height="25" Margin="0,0,4,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BookText" FontSize="16" FontWeight="Bold"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChapterText" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button x:Name="VersionButton" Grid.Column="1"
                    Click="VersionButton_Click" Height="25"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="Bold"
                           MaxWidth="80" TextTrimming="CharacterEllipsis"/>
            </Button>

            <!-- Chapter cycle: prev / next within the current book -->
            <Button x:Name="PrevChapterButton" Grid.Column="2"
                    Click="PrevChapterButton_Click"
                    Width="25" Height="25" Margin="4,0,0,0"
                    Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Previous chapter">
                <iconPacks:PackIconMaterial x:Name="PrevChapterIcon"
                                            Kind="ChevronLeft"
                                            Width="16" Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="NextChapterButton" Grid.Column="3"
                    Click="NextChapterButton_Click"
                    Width="25" Height="25"
                    Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Next chapter">
                <iconPacks:PackIconMaterial x:Name="NextChapterIcon"
                                            Kind="ChevronRight"
                                            Width="16" Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <StackPanel x:Name="ActionsPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0"/>
    </Grid>
</UserControl>