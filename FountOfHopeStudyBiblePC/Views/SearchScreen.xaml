<!-- Views/SearchScreen.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Views.SearchScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SearchRoot"
             Background="{StaticResource AppBackground}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- scope card -->
			<RowDefinition Height="Auto"/>
			<!-- search bar -->
			<RowDefinition Height="Auto"/>
			<!-- options row -->
			<RowDefinition Height="Auto"/>
			<!-- search button -->
			<RowDefinition Height="*"/>
			<!-- results / empty -->
		</Grid.RowDefinitions>

		<!-- ══ Scope card ════════════════════════════════════════════ -->
		<Border Grid.Row="0"
                x:Name="ScopeCard"
                Margin="16,8,16,4"
                CornerRadius="8"
                Padding="14,12"
                Cursor="Hand"
                Background="#FF7FB2FF"
                MouseLeftButtonUp="ScopeCard_Click">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock x:Name="ScopeLabel"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"/>
					<TextBlock x:Name="ScopeDescription"
                               FontSize="12"
                               Foreground="#E6EAF0"
                               Margin="0,2,0,0"/>
				</StackPanel>
				<TextBlock Grid.Column="1"
                           Text="▼"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<!-- ══ Search bar ═══════════════════════════════════════════ -->
		<Border Grid.Row="1"
                Margin="16,4,16,4"
                CornerRadius="8"
                Background="#FF232A33"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="2">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<Button x:Name="VersionChip"
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Change version"
                            Click="VersionChip_Click">
						<TextBlock x:Name="VersionChipText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF7FB2FF"/>
					</Button>
					<Button x:Name="VersionInfoBtn"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Foreground="#FFAAB4C0"
                            Cursor="Hand"
                            ToolTip="Version info"
                            Content="ℹ"
                            Click="VersionInfoBtn_Click"/>
				</StackPanel>

				<TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFE6EAF0"
                         CaretBrush="#FFE6EAF0"
                         FontSize="14"
                         Padding="4,10"
                         VerticalAlignment="Center"
                         KeyDown="SearchBox_KeyDown"
                         TextChanged="SearchBox_TextChanged"/>

				<Button x:Name="ClearBtn"
                        Grid.Column="2"
                        Content="✕"
                        Width="28" Height="28"
                        Margin="2,0,4,0"
                        FontSize="12"
                        Foreground="#FFAAB4C0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="ClearBtn_Click"/>
			</Grid>
		</Border>

		<!-- ══ Options ══════════════════════════════════════════════ -->
		<Grid Grid.Row="2" Margin="16,4,16,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
				<TextBlock Text="Inverse search"
                           FontSize="13"
                           Foreground="#FFAAB4C0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
				<CheckBox x:Name="InverseCheck"
                          VerticalAlignment="Center"
                          Checked="Options_Changed"
                          Unchecked="Options_Changed"/>
			</StackPanel>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
				<TextBlock Text="Exact match"
                           FontSize="13"
                           Foreground="#FFAAB4C0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
				<CheckBox x:Name="ExactCheck"
                          VerticalAlignment="Center"
                          Checked="Options_Changed"
                          Unchecked="Options_Changed"/>
			</StackPanel>
		</Grid>

		<!-- ══ Search button ════════════════════════════════════════ -->
		<Button Grid.Row="3"
                x:Name="SearchBtn"
                Margin="16,4,16,8"
                Height="40"
                Background="#FF7FB2FF"
                BorderThickness="0"
                Foreground="White"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="SearchBtn_Click">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border x:Name="B" CornerRadius="6"
                            Background="{TemplateBinding Background}">
						<TextBlock x:Name="Label"
                                   Text="Search"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="8,0"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="B" Property="Opacity" Value="0.9"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="B" Property="Opacity" Value="0.5"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Button.Template>
		</Button>

		<!-- ══ Results / Empty / Loading / Error ════════════════════ -->
		<Grid Grid.Row="4" Margin="16,0,16,0">

			<!-- Results -->
			<ScrollViewer x:Name="ResultsScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ResultsScroller_ScrollChanged">
				<StackPanel x:Name="ResultsPanel" Margin="0,0,0,16"/>
			</ScrollViewer>

			<!-- Empty state -->
			<StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

			<!-- Loading state -->
			<StackPanel x:Name="LoadingState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
				<TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
				<TextBlock x:Name="LoadingLabel"
                           FontSize="16"
                           Foreground="#FFAAB4C0"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- Error state -->
			<StackPanel x:Name="ErrorState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
				<TextBlock x:Name="ErrorLabel"
                           FontSize="16"
                           Foreground="#FFEB4E4E"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
				<Button Content="Try Again"
                        Margin="0,16,0,0"
                        Padding="16,8"
                        Background="#FF7FB2FF"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        Click="RetryBtn_Click"/>
			</StackPanel>
		</Grid>

		<!-- ══ Back-to-top button ═══════════════════════════════════ -->
		<Button x:Name="BackToTopBtn"
                Grid.Row="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="48" Height="48"
                Margin="0,0,16,16"
                Background="#FF7FB2FF"
                BorderThickness="0"
                Foreground="White"
                FontSize="18"
                Cursor="Hand"
                Visibility="Collapsed"
                ToolTip="Back to top"
                Click="BackToTopBtn_Click">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border CornerRadius="24"
                            Background="{TemplateBinding Background}">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Button.Template>
			<TextBlock Text="↑" FontSize="22" Foreground="White"/>
		</Button>
	</Grid>
</UserControl>