<!-- Views/HomeScreen.xaml -->
<UserControl x:Class="FountOfHopeStudyBiblePC.Views.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FountOfHopeStudyBiblePC.Controls"
             xmlns:models="clr-namespace:FountOfHopeStudyBiblePC.Models"
             x:Name="HomeRoot">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource AppBackground}">
        <StackPanel>

            <!-- ── Spacer(8.dp) ──────────────────────────────────────────── -->
            <FrameworkElement Height="8"/>

            <!-- ── HomeHeader() ──────────────────────────────────────────── -->
            <controls:HomeHeader/>

            <!-- ── ImageSection(...) ─────────────────────────────────────── -->
            <controls:ImageSection x:Name="ImageSectionControl" Margin="0,8,0,0"/>

            <!-- Daily Verse Card -->
<Border x:Name="DailyVerseCard"
        Margin="16,0"
        CornerRadius="20"
        MouseLeftButtonUp="DailyVerseCard_MouseLeftButtonUp"
        Cursor="Hand">
    <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270"
                          Color="Black" Opacity="0.35"/>
    </Border.Effect>
    <Grid MinHeight="100">
        <!-- Random background image -->
        <Image x:Name="DailyVerseBackgroundImage" Stretch="UniformToFill" Margin="0,12,0,-12"/>

        <!-- Gradient overlay (matches Kotlin: 0.7 / 0.5 / 0.6 black) -->
        <Border ClipToBounds="True" Margin="0,12,0,-12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0.0"/>
                    <GradientStop Color="#80000000" Offset="0.5"/>
                    <GradientStop Color="#99000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title + refresh -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Fresh Revelations"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="RefreshVerseButton"
                        Grid.Column="1" Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Click="RefreshVerseButton_Click" Cursor="Hand">
                    <Grid>
                        <TextBlock x:Name="RefreshIconText" Text="⟳"
                                   FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="RefreshSpinner" Text="◌"
                                   FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>

            <!-- HorizontalDivider -->
            <Border Grid.Row="1" Height="1" Background="White" Margin="0,2,0,25"/>

            <!-- Verse content OR skeleton -->
            <Grid Grid.Row="2">
                <StackPanel x:Name="VerseContentPanel">
                    <TextBlock x:Name="DailyVerseReference"
                               FontSize="14" Foreground="#E6FFFFFF"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="DailyVerseText"
                               FontSize="18" LineHeight="22"
                               TextWrapping="Wrap" TextAlignment="Justify"
                               Foreground="White"/>
                </StackPanel>
                <StackPanel x:Name="VerseSkeletonPanel" Visibility="Collapsed">
                    <Border Height="20" Background="#4DFFFFFF" CornerRadius="4" Margin="0,0,0,8"/>
                    <Border Height="20" Background="#4DFFFFFF" CornerRadius="4" Margin="0,0,0,8"/>
                    <Border Height="20" Background="#4DFFFFFF" CornerRadius="4"/>
                </StackPanel>
            </Grid>

            <!-- Bookmark + Share -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BookmarkVerseButton"
                        Width="40" Height="40"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left"
                        Click="BookmarkVerseButton_Click" Cursor="Hand">
                    <TextBlock x:Name="BookmarkIconText" Text="🔖"
                               FontSize="18" Foreground="White"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <Border Grid.Column="1"
                        BorderBrush="White" BorderThickness="1"
                        CornerRadius="8" Padding="16,8"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="ShareVerseButton_Click">
                    <TextBlock x:Name="ShareVerseButton" Text="Share" Foreground="White"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Border>

            <!-- ── "Quick Access" + QuickAccessCarousel(...) ─────────────── -->
            <TextBlock Text="Quick Access"
                       Margin="16,20,16,8"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource OnSurface}"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="16,0,16,0">
                <ItemsControl x:Name="QuickAccessItems"
                              ItemsSource="{Binding QuickActions, ElementName=HomeRoot}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:QuickAction}">
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Click="QuickAction_Click"
                                    Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── PopularDevotionalsSection(...) ────────────────────────── -->
            <TextBlock Text="Popular Devotionals"
                       Margin="16,22,16,8"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource OnSurface}"/>

            <ItemsControl x:Name="DevotionalItems"
                          ItemsSource="{Binding PopularDevotionals, ElementName=HomeRoot}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PopularDevotional}">
                        <Button Style="{StaticResource DevotionalButtonStyle}"
                                Click="Devotional_Click"
                                Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnSurface}"/>
                                <TextBlock Text="{Binding Snippet}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding BookName, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Chapter, Mode=OneWay}"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding Verse, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Spacer + UsefulSpaceGrid(...) ─────────────────────────── -->
            <FrameworkElement Height="16"/>

            <UniformGrid x:Name="UsefulSpaceGrid"
                         Columns="2"
                         Margin="10,0,10,0">
                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="TakeBibleQuiz_Click">
                    <StackPanel>
                        <TextBlock Text="🎯" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bible Quiz" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="LearnHebrew_Click">
                    <StackPanel>
                        <TextBlock Text="א" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource OnSurface}"/>
                        <TextBlock Text="Learn Hebrew" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="LearnGreek_Click">
                    <StackPanel>
                        <TextBlock Text="Ω" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource OnSurface}"/>
                        <TextBlock Text="Learn Greek" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="OpenDictionary_Click">
                    <StackPanel>
                        <TextBlock Text="📚" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dictionary" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="OpenAnimator_Click">
                    <StackPanel>
                        <TextBlock Text="🎬" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Animator" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UsefulTileStyle}"
                        Click="OpenGenerations_Click">
                    <StackPanel>
                        <TextBlock Text="🌳" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Generations" Margin="0,6,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ── Spacer(17.dp) ─────────────────────────────────────────── -->
            <FrameworkElement Height="17"/>

            <!-- ── FountRain() ───────────────────────────────────────────── -->
            <controls:FountRain x:Name="FountRainControl" Height="460"/>

            <!-- ── Spacer(40.dp) + Footer() + Spacer(20.dp) ─────────────── -->
            <FrameworkElement Height="40"/>
            <controls:Footer/>
            <FrameworkElement Height="20"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>