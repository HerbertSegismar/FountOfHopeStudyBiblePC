<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.NoteSortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sort Notes"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="320"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border CornerRadius="14"
            Background="#FF1C2128"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="20">
        <StackPanel>
            <TextBlock Text="Sort Notes" FontSize="18" FontWeight="Bold"
                       Foreground="#FF7FB2FF" Margin="0,0,0,16"/>
            <StackPanel x:Name="OptionsPanel"/>
            <Button Content="Done" Margin="0,20,0,0"
                    Padding="14,8"
                    Background="#FF7FB2FF" BorderThickness="0"
                    Foreground="White" Cursor="Hand"
                    HorizontalAlignment="Right"
                    Click="DoneButton_Click"/>
        </StackPanel>
    </Border>
</Window>