<!-- Views/Modals/ColorWheelDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.ColorWheelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FountOfHopeStudyBiblePC.Controls"
        Title="Color Picker"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Width="640" Height="820"
        MinWidth="420" MinHeight="560"
        Background="{DynamicResource CardBackground}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Border x:Name="RootBorder" CornerRadius="16" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ Header ════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#FF7FB2FF"
                    CornerRadius="16,16,0,0">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" Width="36" Height="36"
                            FontSize="20" Foreground="White"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Cancel_Click"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Color Picker"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Customize your color selection"
                                   FontSize="11" Foreground="#CCE6EAF0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="32" Height="32"
                            FontSize="14" Foreground="White"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- ══ Body ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,20">

                    <!-- ── Color Wheel ──────────────────────────── -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Color Wheel" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{DynamicResource OnSurface}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <controls:ColorWheelControl x:Name="ColorWheel"
                                                     Width="220" Height="220"
                                                     HorizontalAlignment="Center"
                                                     ColorSelected="ColorWheel_ColorSelected"/>
                    </StackPanel>

                    <!-- ── Selected Color Preview + Hex ─────────── -->
                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="Selected Color" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource OnSurface}"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ColorSwatch" Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="2"/>

                            <TextBox x:Name="HexBox" Grid.Column="1"
                                     Margin="12,0,12,0"
                                     Padding="10,8"
                                     Background="{DynamicResource CardBackgroundAlt}"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource OnSurface}"
                                     CaretBrush="#FFE6EAF0"
                                     FontSize="14"
                                     FontFamily="Consolas"
                                     TextChanged="HexBox_TextChanged"
                                     LostFocus="HexBox_LostFocus"/>

                            <!-- Light preview -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        Background="White"
                                        CornerRadius="8"
                                        BorderBrush="#44AAAAAA"
                                        BorderThickness="1">
                                    <Border x:Name="LightPreview"
                                            Width="20" Height="20"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Light" FontSize="10"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Dark preview -->
                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        Background="Black"
                                        CornerRadius="8"
                                        BorderBrush="#44AAAAAA"
                                        BorderThickness="1">
                                    <Border x:Name="DarkPreview"
                                            Width="20" Height="20"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Dark" FontSize="10"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="HexError"
                                   Text="Invalid hex code"
                                   FontSize="11"
                                   Foreground="#FFEB4E4E"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ── Brightness ───────────────────────────── -->
                    <StackPanel Margin="0,20,0,0">
                        <Grid>
                            <TextBlock Text="Brightness" FontSize="13"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <TextBlock x:Name="BrightnessLabel" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#FF7FB2FF"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="BrightnessSlider"
                                Minimum="0" Maximum="1"
                                ValueChanged="BrightnessSlider_ValueChanged"
                                Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ── Saturation ───────────────────────────── -->
                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Saturation" FontSize="13"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <TextBlock x:Name="SaturationLabel" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#FF7FB2FF"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SaturationSlider"
                                Minimum="0" Maximum="1"
                                ValueChanged="SaturationSlider_ValueChanged"
                                Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ── Opacity ──────────────────────────────── -->
                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Opacity" FontSize="13"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <TextBlock x:Name="OpacityLabel" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#FF7FB2FF"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0" Maximum="1"
                                ValueChanged="OpacitySlider_ValueChanged"
                                Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ── Color Palette ─────────────────────────── -->
                    <TextBlock Text="Quick Palette" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource OnSurface}"
                               Margin="0,20,0,8"/>
                    <WrapPanel x:Name="PalettePanel"/>

                    <!-- ── Action Buttons ───────────────────────── -->
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Height="46"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Foreground="{DynamicResource OnSurface}"
                                FontSize="14"
                                Cursor="Hand"
                                Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B"
                                            CornerRadius="10"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background"
                                                    Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="ApplyButton" Grid.Column="2"
                                Height="46"
                                Background="#FF7FB2FF"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="Apply_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B"
                                            CornerRadius="10"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock Text="✓  Apply"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>