<!-- Views/Modals/VerseOptionsModal.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.VerseOptionsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verse Options"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="480"
        MaxHeight="720"
        MinWidth="360"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder"
            CornerRadius="14"
            Background="#FF1C2128"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- scrollable body -->
            </Grid.RowDefinitions>

            <!-- ── Row 0: gradient header ──────────────────────────────── -->
            <Grid Grid.Row="0" MinHeight="90">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC7FB2FF" Offset="0"/>
                        <GradientStop Color="#CC7FB2FF" Offset="0.25"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20,16">
                    <TextBlock Text="Verse Options"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PassageHeaderText"
                               FontSize="14"
                               Margin="0,4,0,0"
                               Foreground="#E6EAF0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseHeaderButton"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <TextBlock Text="✕" FontSize="16" Foreground="#FFE6EAF0"/>
                </Button>
            </Grid>

            <!-- ── Row 1: scrollable content ───────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,0">
                <StackPanel Margin="20,0,20,20">

                    <!-- Range section -->
                    <StackPanel x:Name="RangeSection">
                        <TextBlock Text="Edit Range"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE6EAF0"
                                   Margin="0,8,0,8"/>

                        <!-- Start slider row -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="From"
                                       Foreground="#FFAAB4C0"
                                       VerticalAlignment="Center"
                                       Width="42"/>
                            <Slider x:Name="StartSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="StartSlider_ValueChanged"/>
                            <Button Grid.Column="2"
                                    x:Name="StartDecButton"
                                    Content="◀"
                                    Width="26" Height="26"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Foreground="#FFE6EAF0"
                                    Cursor="Hand"
                                    Click="StartDecButton_Click"/>
                            <Button Grid.Column="3"
                                    x:Name="StartIncButton"
                                    Content="▶"
                                    Width="26" Height="26"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Foreground="#FFE6EAF0"
                                    Cursor="Hand"
                                    Click="StartIncButton_Click"/>
                        </Grid>

                        <!-- End slider row -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="To"
                                       Foreground="#FFAAB4C0"
                                       VerticalAlignment="Center"
                                       Width="42"/>
                            <Slider x:Name="EndSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="EndSlider_ValueChanged"/>
                            <Button Grid.Column="2"
                                    x:Name="EndDecButton"
                                    Content="◀"
                                    Width="26" Height="26"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Foreground="#FFE6EAF0"
                                    Cursor="Hand"
                                    Click="EndDecButton_Click"/>
                            <Button Grid.Column="3"
                                    x:Name="EndIncButton"
                                    Content="▶"
                                    Width="26" Height="26"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Foreground="#FFE6EAF0"
                                    Cursor="Hand"
                                    Click="EndIncButton_Click"/>
                        </Grid>

                        <TextBlock x:Name="SelectedCountText"
                                   FontSize="12"
                                   Foreground="#FFAAB4C0"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Verse text preview -->
                    <Border Margin="0,16,0,0"
                            CornerRadius="10"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Background="#22FFFFFF"
                            Padding="16">
                        <TextBlock x:Name="PreviewText"
                                   FontSize="14"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="#FFE6EAF0"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Margin="0,20,0,0">

                        <Border x:Name="BookmarkButton"
                                CornerRadius="14"
                                Height="64"
                                Margin="0,0,0,10"
                                Background="#FF232A33"
                                Cursor="Hand"
                                MouseLeftButtonUp="BookmarkButton_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BookmarkIcon"
                                           Grid.Column="0"
                                           Text="🔖"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="BookmarkTitle"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#FFE6EAF0"/>
                                    <TextBlock x:Name="BookmarkSubtitle"
                                               FontSize="12"
                                               Foreground="#88AAB4C0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="18"
                                           Foreground="#66AAB4C0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="HighlightButton"
                                CornerRadius="14"
                                Height="64"
                                Margin="0,0,0,10"
                                Background="#FF232A33"
                                Cursor="Hand"
                                MouseLeftButtonUp="HighlightButton_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HighlightIcon"
                                           Grid.Column="0"
                                           Text="☆"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="HighlightTitle"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#FFE6EAF0"/>
                                    <TextBlock x:Name="HighlightSubtitle"
                                               FontSize="12"
                                               Foreground="#88AAB4C0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="18"
                                           Foreground="#66AAB4C0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ShareButton"
                                CornerRadius="14"
                                Height="64"
                                Margin="0,0,0,10"
                                Background="#FF232A33"
                                Cursor="Hand"
                                MouseLeftButtonUp="ShareButton_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="↗"
                                           FontSize="20"
                                           Foreground="#FFE6EAF0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="ShareTitle"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#FFE6EAF0"/>
                                    <TextBlock Text="Share with friends or social media"
                                               FontSize="12"
                                               Foreground="#88AAB4C0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="18"
                                           Foreground="#66AAB4C0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="NoteButton"
                                CornerRadius="14"
                                Height="64"
                                Background="#FF232A33"
                                Cursor="Hand"
                                MouseLeftButtonUp="NoteButton_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📝"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="NoteTitle"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#FFE6EAF0"/>
                                    <TextBlock Text="Add personal notes"
                                               FontSize="12"
                                               Foreground="#88AAB4C0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="18"
                                           Foreground="#66AAB4C0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Cancel button -->
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Height="46"
                            Margin="0,16,0,0"
                            Background="#FF2A3140"
                            BorderThickness="0"
                            Foreground="#FFE6EAF0"
                            FontSize="15"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B"
                                        CornerRadius="12"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#FF3A4252"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>