<!-- Views/Modals/VerseOptionsModal.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.VerseOptionsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verse Options"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">

	<!-- Scrim: fills the Window (which the code-behind sizes to the owner) -->
	<Grid x:Name="Scrim"
          Background="#80000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

		<!-- Card: fixed width, natural height, centred over the owner -->
		<Border x:Name="RootBorder"
                Width="480"
                MinWidth="360"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
			</Border.Effect>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- ── Row 0: gradient header ──────────────────────── -->
				<Grid Grid.Row="0" MinHeight="90">
					<Grid.Background>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Color="#CC7FB2FF" Offset="0"/>
							<GradientStop Color="#CC7FB2FF" Offset="0.25"/>
							<GradientStop Color="Transparent" Offset="1"/>
						</LinearGradientBrush>
					</Grid.Background>

					<StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20,16">
						<TextBlock Text="Verse Options"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
						<TextBlock x:Name="PassageHeaderText"
                                   FontSize="14"
                                   Margin="0,4,0,0"
                                   Foreground="#E6EAF0"
                                   HorizontalAlignment="Center"/>
					</StackPanel>

					<Button x:Name="CloseHeaderButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
						<TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource OnSurface}"/>
					</Button>
				</Grid>

				<!-- ── Row 1: scrollable content ───────────────────── -->
				<ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="20,0,20,20">

						<!-- Range section -->
						<StackPanel x:Name="RangeSection">
							<TextBlock Text="Edit Range"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnSurface}"
                                       Margin="0,8,0,8"/>

							<!-- Start slider row -->
							<Grid Margin="0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
                                           Text="From"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           VerticalAlignment="Center"
                                           Width="42"/>
								<Slider x:Name="StartSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="StartSlider_ValueChanged"/>
								<Button Grid.Column="2"
                                        x:Name="StartDecButton"
                                        Content="◀"
                                        Width="26" Height="26"
                                        Margin="6,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource OnSurface}"
                                        Cursor="Hand"
                                        Click="StartDecButton_Click"/>
								<Button Grid.Column="3"
                                        x:Name="StartIncButton"
                                        Content="▶"
                                        Width="26" Height="26"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource OnSurface}"
                                        Cursor="Hand"
                                        Click="StartIncButton_Click"/>
							</Grid>

							<!-- End slider row -->
							<Grid Margin="0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
                                           Text="To"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           VerticalAlignment="Center"
                                           Width="42"/>
								<Slider x:Name="EndSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="EndSlider_ValueChanged"/>
								<Button Grid.Column="2"
                                        x:Name="EndDecButton"
                                        Content="◀"
                                        Width="26" Height="26"
                                        Margin="6,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource OnSurface}"
                                        Cursor="Hand"
                                        Click="EndDecButton_Click"/>
								<Button Grid.Column="3"
                                        x:Name="EndIncButton"
                                        Content="▶"
                                        Width="26" Height="26"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource OnSurface}"
                                        Cursor="Hand"
                                        Click="EndIncButton_Click"/>
							</Grid>

							<TextBlock x:Name="SelectedCountText"
                                       FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       Margin="0,8,0,0"/>
						</StackPanel>

						<!-- Verse text preview -->
						<Border Margin="0,16,0,0"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Background="#22FFFFFF"
                                Padding="16">
							<TextBlock x:Name="PreviewText"
                                       FontSize="14"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource OnSurface}"/>
						</Border>

						<!-- Action buttons -->
						<StackPanel Margin="0,20,0,0">

							<Border x:Name="BookmarkButton"
                                    CornerRadius="14"
                                    Height="64"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource CardBackgroundAlt}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="BookmarkButton_Click">
								<Grid Margin="16,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock x:Name="BookmarkIcon"
                                               Grid.Column="0"
                                               Text="🔖"
                                               FontSize="20"
                                               VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                VerticalAlignment="Center">
										<TextBlock x:Name="BookmarkTitle"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource OnSurface}"/>
										<TextBlock x:Name="BookmarkSubtitle"
                                                   FontSize="12"
                                                   Foreground="#88AAB4C0"/>
									</StackPanel>
									<TextBlock Grid.Column="2"
                                               Text="›"
                                               FontSize="18"
                                               Foreground="#66AAB4C0"
                                               VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<Border x:Name="HighlightButton"
                                    CornerRadius="14"
                                    Height="64"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource CardBackgroundAlt}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HighlightButton_Click">
								<Grid Margin="16,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock x:Name="HighlightIcon"
                                               Grid.Column="0"
                                               Text="☆"
                                               FontSize="20"
                                               VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                VerticalAlignment="Center">
										<TextBlock x:Name="HighlightTitle"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource OnSurface}"/>
										<TextBlock x:Name="HighlightSubtitle"
                                                   FontSize="12"
                                                   Foreground="#88AAB4C0"/>
									</StackPanel>
									<TextBlock Grid.Column="2"
                                               Text="›"
                                               FontSize="18"
                                               Foreground="#66AAB4C0"
                                               VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<Border x:Name="ShareButton"
                                    CornerRadius="14"
                                    Height="64"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource CardBackgroundAlt}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="ShareButton_Click">
								<Grid Margin="16,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
                                               Text="↗"
                                               FontSize="20"
                                               Foreground="{DynamicResource OnSurface}"
                                               VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                VerticalAlignment="Center">
										<TextBlock x:Name="ShareTitle"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource OnSurface}"/>
										<TextBlock Text="Share with friends or social media"
                                                   FontSize="12"
                                                   Foreground="#88AAB4C0"/>
									</StackPanel>
									<TextBlock Grid.Column="2"
                                               Text="›"
                                               FontSize="18"
                                               Foreground="#66AAB4C0"
                                               VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<Border x:Name="NoteButton"
                                    CornerRadius="14"
                                    Height="64"
                                    Background="{DynamicResource CardBackgroundAlt}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NoteButton_Click">
								<Grid Margin="16,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
                                               Text="📝"
                                               FontSize="20"
                                               VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                VerticalAlignment="Center">
										<TextBlock x:Name="NoteTitle"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource OnSurface}"/>
										<TextBlock Text="Add personal notes"
                                                   FontSize="12"
                                                   Foreground="#88AAB4C0"/>
									</StackPanel>
									<TextBlock Grid.Column="2"
                                               Text="›"
                                               FontSize="18"
                                               Foreground="#66AAB4C0"
                                               VerticalAlignment="Center"/>
								</Grid>
							</Border>
						</StackPanel>

						<!-- Cancel button -->
						<Button x:Name="CancelButton"
                                Content="Cancel"
                                Height="46"
                                Margin="0,16,0,0"
                                Background="{DynamicResource CardBackgroundAlt}"
                                BorderThickness="0"
                                Foreground="{DynamicResource OnSurface}"
                                FontSize="15"
                                Cursor="Hand"
                                Click="CloseButton_Click">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="B"
                                            CornerRadius="12"
                                            Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="B" Property="Background" Value="#FF3A4252"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>

					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</Window>