<!-- Views/Modals/NotesModal.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.NotesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Note"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">

	<!-- Scrim: fills the Window (which the code-behind sizes to the owner) -->
	<Grid x:Name="Scrim"
          Background="#80000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

		<!-- Card: natural height, fixed width, centred over the owner -->
		<Border x:Name="RootBorder"
                Width="480"
                MaxHeight="720"
                MinWidth="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
			</Border.Effect>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- ── Row 0: gradient header ──────────────────────── -->
				<Grid Grid.Row="0" MinHeight="90">
					<Grid.Background>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Color="#CC7FB2FF" Offset="0"/>
							<GradientStop Color="#CC7FB2FF" Offset="0.25"/>
							<GradientStop Color="Transparent" Offset="1"/>
						</LinearGradientBrush>
					</Grid.Background>

					<StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20,16">
						<TextBlock Text="My Note"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
						<TextBlock x:Name="PassageHeaderText"
                                   FontSize="14"
                                   Margin="0,4,0,0"
                                   Foreground="#E6EAF0"
                                   HorizontalAlignment="Center"/>
					</StackPanel>

					<Button x:Name="CloseHeaderButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
						<TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource OnSurface}"/>
					</Button>
				</Grid>

				<!-- ── Row 1: scrollable content ───────────────────── -->
				<ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="20,0,20,20">

						<!-- Verse text preview -->
						<Border CornerRadius="10"
                                Background="#22FFFFFF"
                                Padding="16">
							<TextBlock x:Name="PreviewText"
                                       FontSize="14"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnSurface}"/>
						</Border>

						<!-- Note editor -->
						<TextBlock Text="Write your note..."
                                   FontSize="13"
                                   Margin="0,16,0,6"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>

						<Border CornerRadius="8"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource AppBackground}">
							<TextBox x:Name="NoteTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="140"
                                     MaxHeight="280"
                                     Padding="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource OnSurface}"
                                     CaretBrush="#FFE6EAF0"
                                     FontSize="14"
                                     SelectionBrush="#557FB2FF"/>
						</Border>

						<!-- Buttons row -->
						<Grid Margin="0,20,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<Button x:Name="DeleteButton"
                                    Grid.Column="0"
                                    Padding="14,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#FFEB4E4E"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="DeleteButton_Click">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="🗑" FontSize="14" VerticalAlignment="Center"/>
									<TextBlock Text="Delete" Margin="4,0,0,0" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<Button x:Name="SaveButton"
                                    Grid.Column="2"
                                    Content="Save"
                                    Padding="20,8"
                                    Background="#FF7FB2FF"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="SaveButton_Click">
								<Button.Template>
									<ControlTemplate TargetType="Button">
										<Border x:Name="B"
                                                CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
											<ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="B" Property="Background" Value="#FF9CC4FF"/>
											</Trigger>
											<Trigger Property="IsEnabled" Value="False">
												<Setter TargetName="B" Property="Opacity" Value="0.5"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
							</Button>
						</Grid>

						<!-- Cancel button -->
						<Button x:Name="CancelButton"
                                Content="Cancel"
                                Height="46"
                                Margin="0,10,0,0"
                                Background="{DynamicResource CardBackgroundAlt}"
                                BorderThickness="0"
                                Foreground="{DynamicResource OnSurface}"
                                FontSize="15"
                                Cursor="Hand"
                                Click="CancelButton_Click">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="B"
                                            CornerRadius="12"
                                            Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="B" Property="Background" Value="#FF3A4252"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>

					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</Window>