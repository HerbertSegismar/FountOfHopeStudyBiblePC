<!-- Views/Modals/BookmarkSortDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.BookmarkSortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sort Bookmarks"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="320"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border CornerRadius="14"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Sort Bookmarks"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FF7FB2FF"
                       Margin="0,0,0,16"/>
            <StackPanel x:Name="OptionsPanel"/>
            <Button Content="Done"
                    Margin="0,20,0,0"
                    Padding="14,8"
                    Background="#FF7FB2FF"
                    BorderThickness="0"
                    Foreground="White"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    Click="DoneButton_Click"/>
        </StackPanel>
    </Border>
</Window>