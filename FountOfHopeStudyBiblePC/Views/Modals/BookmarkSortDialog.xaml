<!-- Views/Modals/BookmarkSortDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.BookmarkSortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sort Bookmarks"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">

    <!-- Scrim: fills the Window (which the code-behind sizes to the owner) -->
    <Grid x:Name="Scrim"
          Background="#80000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

        <!-- Card: natural height, fixed width, centred over the owner -->
        <Border Width="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Sort Bookmarks"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF7FB2FF"
                           Margin="0,0,0,16"/>
                <StackPanel x:Name="OptionsPanel"/>
                <Button Content="Done"
                        Margin="0,20,0,0"
                        Padding="14,8"
                        Background="#FF7FB2FF"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        Click="DoneButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>