<!-- Views/Modals/InteractiveModal.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.InteractiveModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bible Study"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Width="640" Height="520"
        MinWidth="420" MinHeight="320"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Border x:Name="RootBorder"
            CornerRadius="16"
            Padding="20"
            Background="#FF1C2128"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0: Title row ─────────────────────────────────── -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <TextBlock x:Name="TitleText"
                           DockPanel.Dock="Left"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF7FB2FF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TitleWordLink"
                           DockPanel.Dock="Left"
                           Margin="6,0,0,0"
                           FontSize="18"
                           Foreground="#FF7FB2FF"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           MouseLeftButtonUp="TitleWordLink_Click"/>
                <Button x:Name="ColorSwatchButton"
                        DockPanel.Dock="Right"
                        Width="22" Height="22"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ColorSwatchButton_Click"
                        ToolTip="Modal color">
                    <Border CornerRadius="11"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFE6EAF0" Offset="0"/>
                                <GradientStop Color="#FF121523" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Button>
            </DockPanel>

            <!-- ── Row 1: Description / db-switcher row ─────────────── -->
            <StackPanel x:Name="DescriptionPanel"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <Button x:Name="DescriptionButton"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFAAB4C0"
                        Cursor="Hand"
                        Click="DescriptionButton_Click">
                    <TextBlock x:Name="DescriptionText"
                               FontSize="12"
                               Foreground="#FFAAB4C0"/>
                </Button>
                <Button x:Name="NextDbButton"
                        Width="24" Height="24"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Next source"
                        Click="NextDbButton_Click">
                    <TextBlock Text="⏭" FontSize="14" Foreground="#FFAAB4C0"/>
                </Button>
            </StackPanel>

            <!-- ── Row 2: Body ──────────────────────────────────────── -->
            <ScrollViewer x:Name="BodyScroller"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4">
                <TextBlock x:Name="BodyText"
                           FontSize="14"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="#FFE6EAF0"/>
            </ScrollViewer>

            <!-- ── Row 3: Buttons ───────────────────────────────────── -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BackButton"
                        Content="Back"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Foreground="#FFE6EAF0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="BackButton_Click"/>
                <Button x:Name="CloseButton"
                        Content="Close"
                        Padding="14,6"
                        Background="#FF7FB2FF"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>