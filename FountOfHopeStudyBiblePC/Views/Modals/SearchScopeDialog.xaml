<!-- Views/Modals/SearchScopeDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.SearchScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Search Scope"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Width="440" Height="640"
        MinWidth="340" MinHeight="400"
        Background="#FF1C2128"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Border CornerRadius="14" Background="#FF1C2128"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#FF7FB2FF" CornerRadius="14,14,0,0">
                <Grid Margin="16,10,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Select Search Scope"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="32" Height="32"
                            FontSize="14"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Category list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CategoryList" Margin="0,0,0,8"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>