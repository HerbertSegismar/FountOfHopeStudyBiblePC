<!-- Views/Modals/NavigationModal.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.NavigationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Passage"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="520" Height="820"
        MinWidth="380" MinHeight="520"
        Background="{DynamicResource CardBackground}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="NumpadDigitStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF7FB2FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="48" Background="#FF7FB2FF">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Width="36" Height="36"
                        Content="←"
                        FontSize="20"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"/>
                <TextBlock Grid.Column="1"
                           Text="Select Passage"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Book list -->
        <ScrollViewer Grid.Row="1"
                      x:Name="BooksScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,8">
            <StackPanel>
                <TextBlock Text="Old Testament"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF7FB2FF"
                           Margin="4,4,0,8"/>
                <WrapPanel x:Name="OldTestamentPanel" Orientation="Horizontal"/>

                <TextBlock Text="New Testament"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFB17DF5"
                           Margin="4,16,0,8"/>
                <WrapPanel x:Name="NewTestamentPanel" Orientation="Horizontal"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Input panel -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppBackground}"
                Padding="12,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>

                <!-- Book header -->
                <Border x:Name="BookHeaderCard"
                        CornerRadius="6"
                        Background="#FF7FB2FF"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="BookHeaderTitle"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="BookHeaderSubtitle"
                                       FontSize="11"
                                       Foreground="{DynamicResource OnSurface}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="White">
                            <TextBlock x:Name="BookHeaderShort"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF7FB2FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chapter / Verse inputs -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Chapter"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                   Margin="0,0,0,4"/>
                        <Border x:Name="ChapterInputBorder"
                                Height="52"
                                CornerRadius="6"
                                Background="#FFF5F5DC"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="ChapterInput_Click">
                            <Grid Margin="12,0">
                                <TextBlock x:Name="ChapterValue"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="#FF7FB2FF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChapterHint"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Verse"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                   Margin="0,0,0,4"/>
                        <Border x:Name="VerseInputBorder"
                                Height="52"
                                CornerRadius="6"
                                Background="#FFF5F5DC"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="VerseInput_Click">
                            <Grid Margin="12,0">
                                <TextBlock x:Name="VerseValue"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="#FF7FB2FF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="VerseHint"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Numpad row 1 -->
                <UniformGrid Columns="6" Height="42" Margin="0,0,0,4">
                    <Button Tag="1" Content="1" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="2" Content="2" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="3" Content="3" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="4" Content="4" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="5" Content="5" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Content="⌫" FontSize="18" Background="#FF7FB2FF" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="Backspace_Click"/>
                </UniformGrid>

                <!-- Numpad row 2 -->
                <UniformGrid Columns="6" Height="42" Margin="0,0,0,4">
                    <Button Tag="6" Content="6" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="7" Content="7" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="8" Content="8" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="9" Content="9" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Tag="0" Content="0" FontSize="20" Style="{StaticResource NumpadDigitStyle}" Click="NumpadDigit_Click"/>
                    <Button Content="✓" FontSize="18" Background="#FFB17DF5" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="Confirm_Click"/>
                </UniformGrid>

                <!-- Numpad row 3 -->
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Clear"
                            FontSize="14" FontWeight="Medium"
                            Background="#FFEB4E4E" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="Clear_Click"/>

                    <Button Grid.Column="2" x:Name="GoToButton"
                            Content="Go to…"
                            FontSize="13" FontWeight="Medium"
                            Background="#FFB17DF5" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="Confirm_Click"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>