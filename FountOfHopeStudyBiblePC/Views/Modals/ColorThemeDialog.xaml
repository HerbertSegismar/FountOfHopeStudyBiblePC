<!-- Views/Modals/ColorThemeDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.ColorThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Theme Color"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Width="440" Height="640"
        MinWidth="360" MinHeight="480"
        Background="#FF1C2128"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Border CornerRadius="16" Background="#FF1C2128"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#FF7FB2FF"
                    CornerRadius="16,16,0,0">
                <Grid Margin="16,12">
                    <TextBlock Text="Choose Theme Color"
                               FontSize="17" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" Width="32" Height="32"
                            HorizontalAlignment="Right"
                            FontSize="14" Foreground="White"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16">

                    <TextBlock Text="Presets" FontSize="14"
                               FontWeight="SemiBold" Foreground="#FFE6EAF0"
                               Margin="0,0,0,12"/>
                    <UniformGrid x:Name="PresetGrid" Columns="3"/>

                    <TextBlock Text="Custom" FontSize="14"
                               FontWeight="SemiBold" Foreground="#FFE6EAF0"
                               Margin="0,24,0,12"/>

                    <Border x:Name="CustomCard"
                            Background="#FF232A33"
                            CornerRadius="12"
                            Padding="16"
                            Cursor="Hand"
                            MouseLeftButtonUp="CustomCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48" Height="48"
                                    CornerRadius="24"
                                    BorderBrush="#FF7FB2FF"
                                    BorderThickness="2">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF7FB2FF" Offset="0.3"/>
                                        <GradientStop Color="#FFD946EF" Offset="0.7"/>
                                        <GradientStop Color="#FFEF4444" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Custom Color Picker"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="#FFE6EAF0"/>
                                <TextBlock Text="Choose any color with the color wheel"
                                           FontSize="11" Foreground="#FFAAB4C0"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="→"
                                       FontSize="18" Foreground="#FFAAB4C0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,8,16,16">
                <Button Content="Cancel"
                        Height="44"
                        HorizontalAlignment="Right"
                        Padding="24,0"
                        Background="Transparent"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        Foreground="#FFE6EAF0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>