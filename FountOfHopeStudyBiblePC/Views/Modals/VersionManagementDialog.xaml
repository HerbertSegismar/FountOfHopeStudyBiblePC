<!-- Views/Modals/VersionManagementDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.VersionManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bible Versions"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">

	<!-- Scrim: fills the Window (which the code-behind sizes to the owner) -->
	<Grid x:Name="Scrim"
          Background="#80000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

		<!-- Card -->
		<Border Width="520" Height="720"
                MinWidth="380" MinHeight="480"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="14"
                Background="#FF1C2128"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" Background="#FF7FB2FF" CornerRadius="14,14,0,0">
					<Grid Margin="20,10,8,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Bible Versions"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
						<Button Grid.Column="1" Content="✕" Width="32" Height="32"
                                FontSize="14" Foreground="White"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="Close_Click"/>
					</Grid>
				</Border>

				<Border Grid.Row="1" Padding="20,8">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Select All"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#FFE6EAF0" VerticalAlignment="Center"/>
						<CheckBox x:Name="SelectAllCheck" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
					</Grid>
				</Border>

				<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
					<StackPanel x:Name="VersionsList" Margin="0,0,0,8"/>
				</ScrollViewer>

				<Border Grid.Row="3" Padding="16,8,16,16">
					<Button Content="Done" HorizontalAlignment="Right"
                            Padding="20,8"
                            Background="#FF7FB2FF" BorderThickness="0"
                            Foreground="White" Cursor="Hand"
                            Click="Close_Click"/>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>