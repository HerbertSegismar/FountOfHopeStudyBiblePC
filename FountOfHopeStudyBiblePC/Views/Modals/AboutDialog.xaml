<!-- Views/Modals/AboutDialog.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.Views.Modals.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        SizeToContent="Height"
        Width="420"
        Background="#FF1C2128"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border CornerRadius="14" Background="#FF1C2128"
            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="Fount of Hope Study Bible"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#FF7FB2FF"/>
            <TextBlock Text="Version 1.2.1" FontSize="14"
                       FontWeight="Medium" Foreground="#FFE6EAF0"
                       Margin="0,8,0,0"/>
            <TextBlock Text="Developed by Fount of Hope Devotionals"
                       FontSize="13" Foreground="#FFE6EAF0"
                       Margin="0,8,0,0"/>
            <TextBlock Text="fountofhopedevotionals@gmail.com"
                       FontSize="12" Foreground="#FF7FB2FF"
                       Margin="0,6,0,0"/>
            <TextBlock Text="Thank you for using Fount of Hope Study Bible. Your support means a lot to us!"
                       FontSize="12" Foreground="#FFAAB4C0"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>
            <Button Content="Close" HorizontalAlignment="Right"
                    Margin="0,20,0,0" Padding="16,8"
                    Background="#FF7FB2FF" BorderThickness="0"
                    Foreground="White" Cursor="Hand"
                    Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>