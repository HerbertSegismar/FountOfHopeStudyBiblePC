<!-- App.xaml -->
<Application x:Class="FountOfHopeStudyBiblePC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme brushes -->
            <SolidColorBrush x:Key="AppBackground"     Color="#FF101418"/>
            <SolidColorBrush x:Key="CardBackground"    Color="#FF1C2128"/>
            <SolidColorBrush x:Key="CardBackgroundAlt" Color="#FF232A33"/>
            <SolidColorBrush x:Key="AccentBrush"       Color="#FF7FB2FF"/>
            <SolidColorBrush x:Key="OnSurface"         Color="#FFE6EAF0"/>
            <SolidColorBrush x:Key="OnSurfaceVariant"  Color="#FFAAB4C0"/>
            <SolidColorBrush x:Key="DividerBrush"      Color="#22FFFFFF"/>

            <!-- Quick-action tile style -->
            <Style x:Key="QuickActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="112"/>
                <Setter Property="Height" Value="132"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    CornerRadius="18"
                                    ClipToBounds="True"
                                    Background="{StaticResource CardBackgroundAlt}">
                                <Grid>
                                    <Image x:Name="Bg"
                                           Source="{Binding BackgroundImage}"
                                           Stretch="UniformToFill"
                                           Opacity="0.45"/>
                                    <Border Background="#66000000"/>
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="30"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OnSurface}"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,10,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OnSurface}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat icon button style -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="19"
                                    Background="{StaticResource CardBackgroundAlt}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Devotional list item -->
            <Style x:Key="DevotionalButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="16,0,16,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="14" Padding="14"
                                    Background="{StaticResource CardBackground}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource CardBackgroundAlt}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Useful-space tile -->
            <Style x:Key="UsefulTileStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="16"
                                    Background="{StaticResource CardBackground}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource CardBackgroundAlt}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>