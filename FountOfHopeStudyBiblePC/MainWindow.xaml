<!-- MainWindow.xaml -->
<Window x:Class="FountOfHopeStudyBiblePC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fount of Hope Study Bible"
        Height="900" Width="640"
        MinHeight="520" MinWidth="380"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="AppBarHost" Grid.Row="0"/>
        <ContentControl x:Name="RootContent" Grid.Row="1"/>
    </Grid>
</Window>